rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email_verified == true
          && request.auth.token.email == 'zerayakkabi@gmail.com')
        || request.auth.token.admin == true
        || request.auth.token.role in ['admin', 'sub_admin']
      );
    }

    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
      );
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      match /{document=**} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_options/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /home_sections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wheel_campaigns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wheel_rewards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /stock_alerts/{id} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid);
    }

    match /support_threads/{threadId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || resource.data.uid == null;
      allow list: if isAdmin();
      allow create: if (signedIn()
          && request.resource.data.uid == request.auth.uid)
        || (!signedIn()
          && request.resource.data.uid == null
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() >= 20
          && request.resource.data.sessionId.size() <= 100);
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid)
        || (!signedIn()
          && resource.data.uid == null
          && request.resource.data.uid == null
          && request.resource.data.sessionId == resource.data.sessionId);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/support_threads/$(threadId)).data.uid
              == request.auth.uid);
        allow read: if get(/databases/$(database)/documents/support_threads/$(threadId)).data.uid == null;
        allow create: if !signedIn()
          && get(/databases/$(database)/documents/support_threads/$(threadId)).data.uid == null
          && request.resource.data.sessionId
            == get(/databases/$(database)/documents/support_threads/$(threadId)).data.sessionId;
        allow update, delete: if isAdmin();
      }
    }

    match /refund_requests/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /carts/{userId}/items/{id} {
      allow read, write: if isAdmin() || (signedIn() && userId == request.auth.uid);
    }

    match /wishlists/{userId}/items/{id} {
      allow read, write: if isAdmin() || (signedIn() && userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
